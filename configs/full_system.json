{
  "scope": "large-scale biodiversity edge AI system",
  "dataset": {
    "name": "iNaturalist 2021",
    "classes": 10000,
    "training_images": 2686843,
    "validation_images": 50000,
    "test_images": 50000
  },
  "deployment": {
    "device": "Raspberry Pi Zero 2 W",
    "vision_model": "EfficientNet-B0",
    "vision_formats": ["fp32", "drq", "full_int8"],
    "geo_prior": true,
    "fusion_modes": ["bayes", "log_linear"],
    "pruning_targets": [0.3, 0.5, 0.7]
  }
}
